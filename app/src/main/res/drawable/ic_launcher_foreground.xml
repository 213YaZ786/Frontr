<?xml version="1.0" encoding="utf-8"?>
<!-- Frontr launcher glyph: subreddits as dots that melt into each other,
     because communities share their members and spill into one another.
     Depth comes from size and tint: the near dot is the palest, the far ones
     sink towards the background colour. Each dot is a soft sphere: a grey
     bitmap, lit from the upper left, multiplied by its tone of the
     wallpaper's accent, under a faint white sheen, over a soft shadow.
     The shapes are those of the approved sketch; the colours are dynamic
     palette resources, see res/values/colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/frontr_far_shadow" />
    <item>
        <bitmap
            android:src="@drawable/frontr_far"
            android:tint="@color/ic_launcher_far"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/frontr_far_shine" />
    <item android:drawable="@drawable/frontr_mid_shadow" />
    <item>
        <bitmap
            android:src="@drawable/frontr_mid"
            android:tint="@color/ic_launcher_mid"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/frontr_mid_shine" />
    <item android:drawable="@drawable/frontr_near_shadow" />
    <item>
        <bitmap
            android:src="@drawable/frontr_near"
            android:tint="@color/ic_launcher_glyph"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/frontr_near_shine" />
</layer-list>
